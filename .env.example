# Copy to backend/.env; fill secrets locally. Existing OS/container env wins.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
AllowedHosts=localhost;127.0.0.1;10.0.2.2

ConnectionStrings__Default="Host=127.0.0.1;Port=55432;Database=bcobca_db;Username=bcobca;Password=CHANGE_ME"
# Docker Compose only: generate a random hex password; leave local connection above unchanged.
POSTGRES_PASSWORD=

Jwt__Issuer=BCOBCA
Jwt__Audience=BCOBCA.App
# Generate a random secret of at least 32 bytes; must not be a placeholder.
Jwt__SigningKey=
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
Jwt__ClockSkewSeconds=30

Auth__RateLimitPermit=30
Auth__RateLimitWindowSeconds=300
Auth__ActionTokenMinutes=30

Cors__Origins__0=http://localhost:8081
Cors__Origins__1=http://localhost:8082
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Warning
Checkout__ShippingFee=0
Checkout__ReservationHours=24
Inventory__SweepIntervalSeconds=60

# Set approved business rules explicitly. Zero disables monetary-order rewards.
Membership__SpendPerPoint=0
Affiliate__CommissionRate=0
Affiliate__ApprovalHoldDays=14
Settlement__PlatformFeeRate=0
Settlement__HoldDays=14
# Base64-encoded 32 random bytes; required before accepting bank details.
Security__BankDataKey=

# One-time local CLI provisioning; remove from the real .env after use.
# Bootstrap__Email=
# Bootstrap__Password=
# Bootstrap__FullName=

# Configure when the corresponding integration is enabled.
# Smtp__Host=
# Smtp__Port=587
# Smtp__EnableSsl=true
# Smtp__Username=
# Smtp__Password=
# Smtp__From=
# App__PublicUrl=http://localhost:8081
# Payments__Provider=
# Payments__WebhookSecret=
